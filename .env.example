# ── Site ────────────────────────────────────────────────────────────────
# Canonical origin. Drives canonical URLs, hreflang, sitemap and OG image
# URLs. Falls back to the Vercel deployment URL, then localhost.
# Beklenen değer: https://mimarineyacht.com (alan adı alınıp Vercel'e
# bağlandıktan sonra Vercel → Settings → Environment Variables'a girilir).
NEXT_PUBLIC_SITE_URL=

# ── Sanity ──────────────────────────────────────────────────────────────
# Studio /studio adresinde. CORS kaydının "Allow credentials" işaretli
# olması gerekir, yoksa Studio'ya giriş yapılamaz.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=

# ── Harita ──────────────────────────────────────────────────────────────
# Harita Leaflet + OpenStreetMap kullanıyor: hesap, API key ve kredi kartı
# gerektirmez. Bu yüzden burada bir değişken yok. Harita ancak bayilerin
# koordinatları girildiğinde görünür; yoksa yer tutucu görsel gösterilir.

# ── Resend — iletişim formu ─────────────────────────────────────────────
# CONTACT_EMAIL_FROM **Resend'de doğrulanmış bir domainde** olmalı.
# outlook.com / gmail.com gibi adresler gönderici olarak KABUL EDİLMEZ —
# o domainleri siz doğrulayamazsınız. Domain yokken tek seçenek Resend'in
# test göndericisi: onboarding@resend.dev (yalnızca hesap sahibinin adresine
# mail atabilir).
# CONTACT_EMAIL_TO burada yedektir; asıl alıcı Sanity Studio →
# Site Ayarları → "İletişim formu alıcı adresi" alanından yönetilir.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# ── Gemini — site asistanı (chatbot) ────────────────────────────────────
# Google AI Studio'dan alınır, kredi kartı gerektirmez.
# Anahtar yoksa sohbet balonu hiç render edilmez.
GEMINI_API_KEY=
# Opsiyonel. Boşsa gemini-3.5-flash-lite kullanılır.
GEMINI_MODEL=
