# ── Site ────────────────────────────────────────────────────────────────
# Canonical origin. Drives canonical URLs, hreflang, sitemap and OG image
# URLs. Falls back to the Vercel deployment URL, then localhost.
NEXT_PUBLIC_SITE_URL=

# ── Sanity (faz 2) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=

# ── Mapbox — Bayi ve Servis Ağı haritası ────────────────────────────────
# Henüz kullanılmıyor; bkz. MANUEL.md → "Harita".
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Resend — iletişim formu ─────────────────────────────────────────────
# CONTACT_EMAIL_FROM, Resend'de doğrulanmış bir domainde olmalı.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
